---
// DownloadButton.astro
// Hiển thị nút tải xuống kèm badge lượt tải
// Props: href (URL file), label (tên file/phiên bản)

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<div class="download-wrapper">
  <a
    href={href}
    class="download-btn"
    id="download-btn"
    data-href={href}
    onclick="handleDownload(event)"
  >
    <span class="download-icon">⬇</span>
    <span class="download-label">{label}</span>
    <span class="download-badge" id="download-badge">
      <span class="badge-dot"></span>
      <span id="download-count">…</span> lượt tải
    </span>
  </a>
  <p class="download-hint">✓ Đã được kiểm tra bởi cộng đồng giáo viên</p>
</div>

<script is:inline>
  // Fetch count khi tải trang
  async function fetchCount() {
    try {
      const res = await fetch('/api/downloads');
      const data = await res.json();
      const el = document.getElementById('download-count');
      if (el) el.textContent = data.count.toLocaleString('vi-VN');
    } catch {
      const el = document.getElementById('download-count');
      if (el) el.textContent = '—';
    }
  }

  // Tăng count khi click
  async function handleDownload(event) {
    event.preventDefault();
    const btn = document.getElementById('download-btn');
    const href = btn?.dataset?.href;
    try {
      const res = await fetch('/api/downloads', { method: 'POST' });
      const data = await res.json();
      const el = document.getElementById('download-count');
      if (el) el.textContent = data.count.toLocaleString('vi-VN');
    } catch {
      // Vẫn cho tải dù API lỗi
    }
    if (href) window.location.href = href;
  }

  fetchCount();
</script>

<style>
  .download-wrapper {
    margin: 1.5rem 0;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    box-shadow: 0 2px 10px rgba(14, 165, 233, 0.35);
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .download-btn:hover {
    background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
    box-shadow: 0 4px 18px rgba(14, 165, 233, 0.45);
    transform: translateY(-1px);
    color: #fff;
  }

  .download-icon {
    font-size: 1.1rem;
  }

  .download-label {
    white-space: nowrap;
  }

  .download-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 0.2rem 0.65rem;
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }

  .badge-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #86efac;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(134, 239, 172, 0.4);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .download-hint {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    color: var(--sl-color-gray-3);
  }
</style>
